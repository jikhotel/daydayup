.login-mask {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
    background: rgba(24, 34, 54, 0.55);
}

.login-card {
    box-sizing: border-box;
    width: 100%;
    max-width: 640rpx;
    padding: 56rpx 44rpx 48rpx;
    border-radius: 32rpx;
    background: #ffffff;
    box-shadow: 0 24rpx 80rpx rgba(20, 30, 60, 0.24);
    text-align: center;
}

.login-icon {
    font-size: 88rpx;
    line-height: 1;
}

.login-title {
    display: block;
    margin-top: 20rpx;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.login-desc {
    display: block;
    margin-top: 10rpx;
    margin-bottom: 40rpx;
    font-size: 26rpx;
    color: #8a9099;
}

.field {
    margin-bottom: 28rpx;
    text-align: left;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #4e535b;
}

.field-input {
    box-sizing: border-box;
    width: 100%;
    height: 92rpx;
    padding: 0 24rpx;
    border: 2rpx solid #e3e6eb;
    border-radius: 16rpx;
    background: #f7f8fa;
    font-size: 30rpx;
    color: #1f2329;
}

.field-error,
.field-hint {
    display: block;
    margin-top: 10rpx;
    font-size: 24rpx;
}

.field-error { color: #e5453b; }
.field-hint { color: #8a9099; }

.primary-btn {
    height: 92rpx;
    margin-top: 8rpx;
    border-radius: 16rpx;
    background: linear-gradient(135deg, #3a7afe, #2b62e0);
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 92rpx;
}

.secondary-btn {
    margin-top: 24rpx;
    font-size: 26rpx;
    color: #3a7afe;
}

.form-error {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #e5453b;
}
