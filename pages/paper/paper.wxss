.page { box-sizing: border-box; min-height: 100vh; padding: 40rpx 32rpx 80rpx; }
.loading-veil { display: flex; min-height: 60vh; align-items: center; justify-content: center; }
.spinner { width: 48rpx; height: 48rpx; border: 6rpx solid #e8e0d2; border-top-color: #c9552e; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.config-card {
    padding: 36rpx 32rpx; border: 2rpx solid #efe7d8;
    border-radius: 24rpx; background: linear-gradient(160deg, #fffdf8, #fdf6ec);
}
.field { margin-bottom: 28rpx; }
.field-label { display: block; margin-bottom: 14rpx; font-size: 26rpx; font-weight: 600; color: #5a5248; }
.field-value { padding: 20rpx 24rpx; border: 2rpx solid #e3dbcb; border-radius: 14rpx; background: #fff; font-size: 28rpx; color: #c9552e; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.switch-label { margin-bottom: 0; }
.gen-btn {
    height: 92rpx; border-radius: 18rpx;
    background: linear-gradient(135deg, #d97742, #c9552e);
    color: #fff; font-size: 30rpx; font-weight: 700; line-height: 92rpx;
}
.hint { display: block; margin-top: 18rpx; font-size: 23rpx; color: #9a9184; line-height: 1.6; }

.error-card { margin: 24rpx 0; padding: 24rpx; border-radius: 16rpx; background: #fff0ef; color: #d0403a; font-size: 25rpx; }

.paper-head { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; }
.paper-title { font-size: 28rpx; font-weight: 700; color: #1f1a14; }
.paper-actions { display: flex; gap: 14rpx; }
.mini-btn { height: 64rpx; padding: 0 26rpx; margin: 0; border-radius: 14rpx; background: #f1ece2; color: #5a5248; font-size: 24rpx; font-weight: 600; line-height: 64rpx; }
.mini-btn.primary { background: #c9552e; color: #fff; }
.paper-img { width: 100%; border-radius: 12rpx; box-shadow: 0 8rpx 32rpx rgba(60, 45, 25, 0.18); }

.offscreen-canvas { position: fixed; left: -2000px; top: 0; }

.external-tip { padding: 20rpx 24rpx; margin-bottom: 20rpx; border-radius: 16rpx; background: #eef3ff; color: #3a7afe; font-size: 25rpx; }

.pdf-btn {
    height: 92rpx; margin-top: 28rpx;
    border-radius: 18rpx; background: linear-gradient(135deg, #d97742, #c9552e);
    color: #fff; font-size: 30rpx; font-weight: 700; line-height: 92rpx;
}
.pdf-hint { display: block; margin-top: 14rpx; text-align: center; font-size: 22rpx; color: #9a9184; line-height: 1.5; }
