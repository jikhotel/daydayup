.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 80rpx;
}

.loading-veil { display: flex; min-height: 60vh; align-items: center; justify-content: center; }
.spinner { width: 48rpx; height: 48rpx; border: 6rpx solid #dbe8fb; border-top-color: #3a7afe; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.score-hero {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 48rpx 32rpx 40rpx;
    border-radius: 28rpx;
    background: linear-gradient(160deg, #3a7afe, #5b52e8);
    color: #fff;
    box-shadow: 0 16rpx 40rpx rgba(58, 122, 254, 0.26);
}
.score-label { font-size: 26rpx; opacity: 0.9; }
.score-num { margin-top: 8rpx; font-size: 120rpx; font-weight: 800; line-height: 1; }
.score-unit { position: absolute; margin-left: 150rpx; margin-top: 70rpx; font-size: 30rpx; opacity: 0.9; }
.score-stats { display: flex; width: 100%; margin-top: 32rpx; }
.score-stat { flex: 1; display: flex; align-items: center; flex-direction: column; }
.ss-num { font-size: 34rpx; font-weight: 700; }
.ss-label { margin-top: 6rpx; font-size: 22rpx; opacity: 0.85; }
.score-word { margin-top: 28rpx; font-size: 28rpx; font-weight: 600; }

.redo-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx;
    margin-top: 24rpx;
    border-radius: 22rpx;
    background: #fff5ec;
    border: 2rpx solid #ffd9b0;
}
.redo-info { display: flex; flex-direction: column; flex: 1; }
.redo-title { font-size: 30rpx; font-weight: 700; color: #b9641a; }
.redo-desc { margin-top: 8rpx; font-size: 22rpx; color: #b98a5e; }
.redo-btn {
    flex-shrink: 0; margin-left: 16rpx; padding: 0 28rpx;
    height: 76rpx; border-radius: 16rpx;
    background: #f2994a; color: #fff; font-size: 26rpx; font-weight: 700; line-height: 76rpx;
}

.perfect-card { margin-top: 24rpx; padding: 32rpx; border-radius: 20rpx; background: #e8f7f0; color: #1a9c6e; font-size: 28rpx; font-weight: 600; text-align: center; }

.section-title { margin: 40rpx 0 20rpx; font-size: 30rpx; font-weight: 700; color: #1b2230; }

.review-list { display: flex; flex-direction: column; gap: 20rpx; }
.review-item { padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(30,40,70,0.04); }
.review-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.review-badge { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 12rpx; color: #fff; font-size: 26rpx; font-weight: 700; }
.review-badge.right { background: #22b07d; }
.review-badge.wrong { background: #e5453b; }
.review-no { margin-left: 16rpx; font-size: 25rpx; font-weight: 600; color: #1b2230; }
.review-kp { margin-left: auto; padding: 6rpx 14rpx; border-radius: 12rpx; background: #eef3ff; color: #3a7afe; font-size: 20rpx; }
.review-stem { display: block; font-size: 27rpx; color: #1b2230; line-height: 1.6; margin-bottom: 16rpx; }
.review-answer, .review-analysis { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #4e535b; }
.ans-label { color: #9aa0aa; }
.ans-right { color: #1a9c6e; font-weight: 600; }
.ans-wrong { color: #e5453b; font-weight: 600; }
.review-analysis { margin-top: 12rpx; padding-top: 12rpx; border-top: 2rpx solid #f2f3f5; }

.action-row { display: flex; gap: 20rpx; margin-top: 40rpx; }
.act { flex: 1; height: 92rpx; border-radius: 18rpx; font-size: 30rpx; font-weight: 600; line-height: 92rpx; }
.act.ghost { background: #eef0f3; color: #646a73; }
.act.primary { background: #3a7afe; color: #fff; }

.error-card { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: #fff0ef; color: #d0403a; font-size: 25rpx; }
