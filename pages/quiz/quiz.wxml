<login-panel wx:if="{{authState === 'signed-out'}}" bind:signedin="onSignedIn" />

<view class="page" wx:else>
    <view class="loading-veil" wx:if="{{authState === 'checking'}}">
        <view class="spinner"></view>
    </view>

    <block wx:if="{{authState === 'signed-in' && questions.length > 0}}">
        <view class="topbar">
            <view class="top-info">
                <text class="top-subject">{{session.subject}} · {{session.textbook || '综合'}}</text>
                <text class="top-meta">{{session.source === 'mistake' ? '错题强化' : (session.source === 'bank' ? '题库组卷' : 'AI 出题')}} · 共 {{questions.length}} 题</text>
            </view>
            <view class="timer">
                <text class="timer-icon">⏱</text>
                <text class="timer-value">{{elapsed}}</text>
            </view>
        </view>

        <view class="dots">
            <view class="dot {{index === current ? 'current' : ''}} {{item.answered ? 'answered' : ''}}"
                  wx:for="{{questions}}" wx:key="id"
                  data-index="{{index}}" bindtap="jumpTo">{{index + 1}}</view>
        </view>

        <view class="qcard">
            <view class="qhead">
                <text class="qtype">{{questions[current].typeName}}</text>
                <text class="qnum">第 {{current + 1}} / {{questions.length}} 题</text>
            </view>
            <text class="qstem">{{questions[current].stem}}</text>

            <view class="options" wx:if="{{questions[current].hasOptions}}">
                <view class="option {{item.selected ? 'selected' : ''}}"
                      wx:for="{{questions[current].optionView}}" wx:key="letter"
                      data-qid="{{questions[current].id}}" data-value="{{item.letter}}"
                      bindtap="onOptionTap">
                    <text class="opt-letter">{{item.letter}}</text>
                    <text class="opt-text">{{item.text}}</text>
                </view>
            </view>

            <view class="options" wx:elif="{{questions[current].isJudge}}">
                <view class="option {{questions[current].myAnswer === '对' ? 'selected' : ''}}"
                      data-qid="{{questions[current].id}}" data-value="对" bindtap="onChoose">
                    <text class="opt-letter">✓</text><text class="opt-text">对</text>
                </view>
                <view class="option {{questions[current].myAnswer === '错' ? 'selected' : ''}}"
                      data-qid="{{questions[current].id}}" data-value="错" bindtap="onChoose">
                    <text class="opt-letter">✕</text><text class="opt-text">错</text>
                </view>
            </view>

            <view class="blank-wrap" wx:elif="{{questions[current].isBlank}}">
                <input class="blank-input" placeholder="输入你的答案"
                       data-qid="{{questions[current].id}}" bindinput="onBlankInput"
                       value="{{questions[current].myAnswer}}" />
            </view>

            <view class="solve-wrap" wx:elif="{{questions[current].isSolve}}">
                <textarea class="solve-textarea" placeholder="写出你的解答过程或要点（交卷后 AI 阅卷）"
                          data-qid="{{questions[current].id}}" bindinput="onBlankInput"
                          value="{{questions[current].myAnswer}}" maxlength="1000"
                          auto-height disabled="{{submitting}}"></textarea>
                <text class="solve-hint">解答题由 AI 按参考答案判分，要点覆盖即可。</text>
            </view>
        </view>

        <view class="nav-row">
            <button class="nav-btn ghost" disabled="{{current === 0}}" bindtap="goPrev">上一题</button>
            <button class="nav-btn ghost" wx:if="{{current < questions.length - 1}}" bindtap="goNext">下一题</button>
            <button class="nav-btn primary" wx:else bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">交卷判分</button>
        </view>

        <view class="submit-all" bindtap="submit" wx:if="{{current < questions.length - 1}}">直接交卷</view>
        <view class="error-card" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    </block>

    <view class="error-card" wx:if="{{authState === 'signed-in' && questions.length === 0 && errorMsg}}">{{errorMsg}}</view>
</view>
