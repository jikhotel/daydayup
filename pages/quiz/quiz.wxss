.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 80rpx;
}

.loading-veil { display: flex; min-height: 60vh; align-items: center; justify-content: center; }
.spinner { width: 48rpx; height: 48rpx; border: 6rpx solid #dbe8fb; border-top-color: #3a7afe; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.top-info { display: flex; flex-direction: column; }
.top-subject { font-size: 30rpx; font-weight: 700; color: #1b2230; }
.top-meta { margin-top: 8rpx; font-size: 23rpx; color: #8a9099; }

.timer { display: flex; align-items: center; padding: 14rpx 24rpx; border-radius: 18rpx; background: #1f2a4a; }
.timer-icon { font-size: 28rpx; margin-right: 10rpx; }
.timer-value { font-size: 34rpx; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; letter-spacing: 2rpx; }

.dots { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 32rpx; }
.dot {
    display: flex; width: 64rpx; height: 64rpx;
    align-items: center; justify-content: center;
    border: 2rpx solid #e3e6eb; border-radius: 16rpx;
    background: #fff; color: #9aa0aa; font-size: 26rpx; font-weight: 600;
}
.dot.answered { background: #eaf1ff; border-color: #bcd4ff; color: #2b62e0; }
.dot.current { background: #3a7afe; border-color: #3a7afe; color: #fff; }

.qcard {
    min-height: 480rpx;
    padding: 36rpx 32rpx;
    border-radius: 28rpx;
    background: #fff;
    box-shadow: 0 8rpx 28rpx rgba(30, 40, 70, 0.05);
}

.qhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.qtype { padding: 8rpx 20rpx; border-radius: 16rpx; background: #eef3ff; color: #3a7afe; font-size: 24rpx; font-weight: 600; }
.qnum { font-size: 23rpx; color: #9aa0aa; }

.qstem { display: block; font-size: 32rpx; font-weight: 600; color: #1b2230; line-height: 1.7; margin-bottom: 36rpx; }

.options { display: flex; flex-direction: column; gap: 18rpx; }
.option {
    display: flex; align-items: center;
    padding: 24rpx; border: 2rpx solid #e8eaee;
    border-radius: 18rpx; background: #fafbfc;
}
.option.selected { border-color: #3a7afe; background: #eef3ff; }
.opt-letter {
    display: flex; width: 52rpx; height: 52rpx; flex-shrink: 0;
    align-items: center; justify-content: center;
    border-radius: 12rpx; background: #eef0f3; color: #646a73;
    font-size: 26rpx; font-weight: 700;
}
.option.selected .opt-letter { background: #3a7afe; color: #fff; }
.opt-text { margin-left: 20rpx; font-size: 28rpx; color: #1b2230; line-height: 1.5; }

.blank-wrap { padding: 12rpx 0; }
.blank-input {
    box-sizing: border-box; width: 100%; height: 96rpx;
    padding: 0 24rpx; border: 2rpx solid #e3e6eb;
    border-radius: 16rpx; background: #f7f8fa; font-size: 30rpx;
}

.nav-row { display: flex; gap: 20rpx; margin-top: 36rpx; }
.nav-btn { height: 92rpx; border-radius: 18rpx; font-size: 30rpx; font-weight: 600; line-height: 92rpx; flex: 1; }
.nav-btn.ghost { background: #eef0f3; color: #646a73; }
.nav-btn.primary { background: #3a7afe; color: #fff; }

.submit-all { margin-top: 28rpx; text-align: center; font-size: 25rpx; color: #8a9099; text-decoration: underline; }

.error-card { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: #fff0ef; color: #d0403a; font-size: 25rpx; }
