.page {
    padding: 32rpx 28rpx 60rpx;
    box-sizing: border-box;
}

.profile-card {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #3a7afe 0%, #6aa2ff 100%);
    border-radius: 24rpx;
    padding: 40rpx 32rpx;
    margin-bottom: 28rpx;
    color: #fff;
}

.avatar {
    width: 108rpx;
    height: 108rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    font-weight: 600;
    margin-right: 28rpx;
    flex-shrink: 0;
}

.profile-info {
    display: flex;
    flex-direction: column;
}

.profile-name {
    font-size: 36rpx;
    font-weight: 600;
}

.profile-sub {
    font-size: 24rpx;
    opacity: 0.85;
    margin-top: 8rpx;
}

.menu {
    background: #fff;
    border-radius: 20rpx;
    overflow: hidden;
}

.menu-item {
    display: flex;
    align-items: center;
    padding: 32rpx 30rpx;
    border-bottom: 1rpx solid #f0f2f5;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-icon {
    font-size: 34rpx;
    margin-right: 22rpx;
}

.menu-text {
    flex: 1;
    font-size: 30rpx;
    color: #2a2f36;
}

.menu-arrow {
    color: #c0c4cc;
    font-size: 32rpx;
}

.logout-btn {
    margin-top: 40rpx;
    background: #fff;
    color: #e5484d;
    border-radius: 20rpx;
    font-size: 30rpx;
    height: 96rpx;
    line-height: 96rpx;
}

.version {
    display: block;
    text-align: center;
    color: #9aa0aa;
    font-size: 24rpx;
    margin-top: 28rpx;
}

/* loading 遮罩 */
.loading-veil {
    position: fixed;
    inset: 0;
    background: #f5f7fa;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}

.spinner {
    width: 56rpx;
    height: 56rpx;
    border: 6rpx solid #d8e3ff;
    border-top-color: #3a7afe;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
