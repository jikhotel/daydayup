<login-panel wx:if="{{authState === 'signed-out'}}" bind:signedin="onSignedIn" />

<view class="page" wx:else>
    <view class="loading-veil" wx:if="{{authState === 'checking'}}">
        <view class="spinner"></view>
    </view>

    <block wx:if="{{authState === 'signed-in'}}">
        <view class="profile-card">
            <view class="avatar">{{initial}}</view>
            <view class="profile-info">
                <text class="profile-name">{{user.name || '练习用户'}}</text>
                <text class="profile-sub">云端账号已登录，练习与错题实时同步</text>
            </view>
        </view>

        <view class="menu">
            <view class="menu-item" bindtap="showAbout">
                <text class="menu-icon">ℹ️</text>
                <text class="menu-text">关于 DayDayUp</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <button class="logout-btn" bindtap="onSignOut">退出登录</button>
        <text class="version">DayDayUp · v0.2.5</text>
    </block>
</view>
