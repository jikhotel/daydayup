<login-panel wx:if="{{authState === 'signed-out'}}" bind:signedin="onSignedIn" />

<view class="page" wx:else>
    <view class="loading-veil" wx:if="{{authState === 'checking'}}">
        <view class="spinner"></view>
    </view>

    <block wx:if="{{authState === 'signed-in'}}">
        <view class="hero">
            <text class="hero-title">DayDayUp</text>
            <text class="hero-sub">选一个学科开始做题 · 云端题库 + AI 出题</text>
        </view>

        <view class="error-card" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <view class="subject-grid" wx:if="{{subjects.length > 0}}">
            <view class="subject-card" wx:for="{{subjects}}" wx:key="code"
                  data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goSetup">
                <view class="card-mark" style="background: {{item.color}}">
                    <text class="card-icon">{{item.icon}}</text>
                </view>
                <text class="card-name">{{item.name}}</text>
                <text class="card-meta">{{item.countText || '加载中…'}}</text>
            </view>
        </view>

        <view class="loading-inline" wx:if="{{loading}}">
            <view class="spinner small"></view>
            <text>统计题库中…</text>
        </view>

        <view class="footer-link" bindtap="goMistakes">📕 查看错题本</view>
    </block>
</view>
